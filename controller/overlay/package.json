{
  "name": "nejimakidori-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Mahjong Soul model overlay",
  "author": "edgy-raven",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.squareqrow.nejimakidori.overlay",
    "productName": "Nejimakidori",
    "electronVersion": "45.2.1",
    "directories": {"app": "..", "output": "dist"},
    "extraMetadata": {
      "name": "nejimakidori-overlay",
      "main": "overlay/main.mjs",
      "description": "Windows Mahjong Soul model overlay",
      "author": "edgy-raven"
    },
    "files": [
      "overlay/main.mjs", "overlay/preload.cjs", "overlay/tracker.mjs",
      "overlay/index.html", "overlay/renderer.mjs", "overlay/style.css",
      "mahjongsoul_live_state.mjs", "mahjongsoul_protocol.mjs",
      "mahjongsoul_terminal.mjs", "mahjongsoul_yaku.mjs",
      "mahjongsoul_liqi.json", "domain/*.js", "package.json"
    ],
    "win": {"target": "portable", "signAndEditExecutable": false}
  }
}
