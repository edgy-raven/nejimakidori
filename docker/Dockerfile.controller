FROM node:22-bookworm

ENV PYTHONUNBUFFERED=1 PYTHON_PATH=/usr/bin/python3 CHROME_PATH=/usr/bin/chromium
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY controller/vision/requirements.txt /tmp/vision-requirements.txt
RUN pip3 install --break-system-packages -r /tmp/vision-requirements.txt
COPY controller /app/controller
WORKDIR /app/controller
RUN npm ci --omit=dev
ENV HOME=/state
CMD ["npm", "start"]
