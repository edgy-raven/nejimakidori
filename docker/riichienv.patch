+@pytest.mark.parametrize(
+    "win_type,winner",
+    [(riichienv.ActionType.TSUMO, 2), (riichienv.ActionType.RON, 3)],
+)
+def test_last_personal_draw_allows_scored_wins_but_no_calls(win_type, winner):
+    rule = riichienv.GameRule.default_tenhou()
+    rule.duplicate = True
+    # Seat 0 could pon the final East in a non-exhausted wall. Keeping
+    # these copies concealed also avoids an earlier East causing furiten.
+    hands = [[110, 111], [], [], []]
+    hands[winner] = [0, 1, 8, 9, 16, 17, 36, 37, 44, 45, 72, 73, 108]
+    wall = make_wall(hands, last_draw=109)
+    env = riichienv.RiichiEnv(seed=7, game_mode=0, rule=rule)
+    env.reset(wall=wall)
+    for _ in range(300):
+        if env.drawn_tile == 109:
+            break
+        discard_or_pass(env)
+    assert env.current_player == 2
+    assert env.drawn_tile == 109
+    assert not env.done()
+    obs = env.get_observations([2])[2]
+    assert obs.tiles_left == 0
+    assert env.mjai_log[-1]["type"] == "tsumo"
+    assert env.mjai_log[-1]["tiles_left"] == 0
+    restored = riichienv.Observation.deserialize_from_base64(
+        obs.serialize_to_base64()
+    )
+    assert restored.tiles_left == 0
+    for observation in (obs, restored):
+        assert all(
+            value == 0
+            for value in memoryview(observation.encode()).cast("f")[
+                30 * 34 : 31 * 34
+            ]
+        )
+        assert all(
+            value == 0
+            for value in memoryview(observation.encode_extended()).cast("f")[
+                30 * 34 : 31 * 34
+            ]
+        )
+        assert memoryview(observation.encode_seq_sparse()).cast("H")[4] == 13
+    forbidden = {
+        riichienv.ActionType.CHI,
+        riichienv.ActionType.PON,
+        riichienv.ActionType.ANKAN,
+        riichienv.ActionType.KAKAN,
+        riichienv.ActionType.DAIMINKAN,
+        riichienv.ActionType.RIICHI,
+    }
+    assert all(
+        action.action_type not in forbidden
+        for action in env.get_observations([2])[2].legal_actions()
+    )
+    if win_type == riichienv.ActionType.RON:
+        env.step({2: riichienv.Action(riichienv.ActionType.DISCARD, tile=109)})
+        assert all(
+            action.action_type not in forbidden
+            for obs in env.get_observations().values()
+            for action in obs.legal_actions()
+        )
+    env.step(
+        {
+            seat: next(
+                action
+                for action in obs.legal_actions()
+                if action.action_type
+                == (win_type if seat == winner else riichienv.ActionType.PASS)
+            )
+            for seat, obs in env.get_observations(env.active_players).items()
+        }
+    )
+    assert env.done()
+    assert env.scores()[winner] > 25000
+    assert sum(env.scores()) == 100000
+    # Standard yaku IDs 5/6 are haitei/houtei, respectively.
+    assert (5 if win_type == riichienv.ActionType.TSUMO else 6) in (
+        env.win_results[winner].yaku
+    )
+
