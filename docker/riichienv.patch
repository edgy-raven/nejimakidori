+"""Duplicate boards preserve each seat's tiles across different calls."""
+
+import random
+
+import pytest
+
+import riichienv
+import riichienv.convert
+
+
+def make_wall(hands, first_draw=None, last_draw=None):
+    """Complete a physical wall around specified initial hand prefixes."""
+    deal_order = [seat for _ in range(3) for seat in range(4) for _ in range(4)]
+    deal_order += list(range(4))
+    wall = [None] * 136
+    for seat, hand in enumerate(hands):
+        positions = [i for i, player in enumerate(deal_order) if player == seat]
+        for position, tile in zip(positions, hand):
+            wall[position] = tile
+    if first_draw is not None:
+        wall[52] = first_draw
+    if last_draw is not None:
+        wall[118] = last_draw
+    remaining = [tile for tile in range(136) if tile not in wall]
+    random.Random(41).shuffle(remaining)
+    for position, tile in enumerate(wall):
+        if tile is None:
+            wall[position] = remaining.pop()
+    assert sorted(wall) == list(range(136))
+    return wall
+
+
+def discard_or_pass(env):
+    """Take one passive decision through the normal action interface."""
+    actions = {}
+    for seat, obs in env.get_observations(env.active_players).items():
+        legal = obs.legal_actions()
+        if env.phase == riichienv.Phase.WaitResponse:
+            actions[seat] = next(
+                action
+                for action in legal
+                if action.action_type == riichienv.ActionType.PASS
+            )
+        else:
+            discards = [
+                action
+                for action in legal
+                if action.action_type == riichienv.ActionType.DISCARD
+            ]
+            actions[seat] = next(
+                (
+                    action
+                    for action in discards
+                    if action.tile == env.drawn_tile
+                ),
+                discards[0],
+            )
+    env.step(actions)
+
+
+def finish_hand(env):
+    """Decline calls and wins, discarding drawn tiles whenever possible."""
+    draws = [[] for _ in range(4)]
+    for _ in range(400):
+        if env.done():
+            return draws
+        event_count = len(env.mjai_log)
+        discard_or_pass(env)
+        for event in env.mjai_log[event_count:]:
+            if event["type"] in ("ryukyoku", "end_kyoku"):
+                return draws
+            if event["type"] == "tsumo":
+                draws[event["actor"]].append(env.drawn_tile)
+    pytest.fail("One hand did not finish within 400 decisions")
+
+
+@pytest.mark.parametrize(
+    "call_type,caller,hands",
+    [
+        (riichienv.ActionType.CHI, 1, [[0], [4, 8], [], []]),
+        (riichienv.ActionType.PON, 2, [[0], [], [1, 2], []]),
+        (riichienv.ActionType.DAIMINKAN, 2, [[0], [], [1, 2, 3], []]),
+        (riichienv.ActionType.ANKAN, 0, [[0, 1, 2, 3], [], [], []]),
+    ],
+)
+def test_calls_preserve_physical_draw_queues(call_type, caller, hands):
+    rule = riichienv.GameRule.default_tenhou()
+    assert not rule.duplicate
+    rule.duplicate = True
+    wall = make_wall(hands)
+    env = riichienv.RiichiEnv(seed=7, game_mode=0, rule=rule)
+    env.reset(wall=wall)
+    initial_tiles = [tile for hand in env.hands for tile in hand]
+    baseline = env.clone()
+    baseline_draws = finish_hand(baseline)
+    baseline_draws[0].insert(0, wall[52])
+
+    if call_type != riichienv.ActionType.ANKAN:
+        env.step({0: riichienv.Action(riichienv.ActionType.DISCARD, tile=0)})
+    actions = {
+        seat: next(
+            action
+            for action in obs.legal_actions()
+            if action.action_type
+            == (call_type if seat == caller else riichienv.ActionType.PASS)
+        )
+        for seat, obs in env.get_observations(env.active_players).items()
+    }
+    env.step(actions)
+    is_kan = call_type in (
+        riichienv.ActionType.ANKAN,
+        riichienv.ActionType.DAIMINKAN,
+    )
+    if is_kan:
+        assert env.is_rinshan_flag
+        replacement = env.drawn_tile
+        assert replacement == wall[56 if caller == 0 else 52 + caller]
+    cloned = env.clone()
+    draws = finish_hand(env)
+    assert finish_hand(cloned) == draws
+    assert cloned.mjai_log == env.mjai_log
+    draws[0].insert(0, wall[52])
+    if is_kan:
+        draws[caller].insert(1 if caller == 0 else 0, replacement)
+        assert env.dora_indicators == [wall[131], wall[129]]
+        assert env._get_ura_markers() == [
+            riichienv.convert.tid_to_mjai(wall[130]),
+            riichienv.convert.tid_to_mjai(wall[128]),
+        ]
+        event_types = [event["type"] for event in env.mjai_log]
+        kan = event_types.index("ankan" if caller == 0 else "daiminkan")
+        draw = event_types.index("tsumo", kan)
+        dora = event_types.index("dora", kan)
+        discard = event_types.index("dahai", draw)
+        assert (dora < draw) if caller == 0 else (draw < dora < discard)
+
+    for seat in range(4):
+        expected = wall[52 + seat : 122 : 4]
+        assert draws[seat] == expected[: len(draws[seat])]
+        assert baseline_draws[seat] == expected[: len(baseline_draws[seat])]
+    physical_tiles = initial_tiles + [
+        tile
+        for seat, tiles in enumerate(draws)
+        for tile in tiles[(1 if seat == 0 else 0) :]
+    ]
+    assert len(set(physical_tiles)) == len(physical_tiles)
+    assert env.done()
+    assert any(event["type"] == "ryukyoku" for event in env.mjai_log)
+    assert any(
+        len(draws[seat]) == len(wall[52 + seat : 122 : 4]) for seat in range(4)
+    )
+
+    env.reset(wall=wall, seed=7)
+    assert [tile for hand in env.hands for tile in hand] == initial_tiles
+    reset_draws = finish_hand(env)
+    reset_draws[0].insert(0, wall[52])
+    assert reset_draws == baseline_draws
+
+
+def test_duplicate_rounds_advance_after_dealer_win_and_exhaustion():
+    rule = riichienv.GameRule.default_tenhou()
+    rule.duplicate = True
+    # The dealer wins immediately with seven pairs; the other table declines.
+    wall = make_wall(
+        [[0, 1, 8, 9, 16, 17, 36, 37, 44, 45, 72, 73, 108], [], [], []],
+        first_draw=109,
+    )
+    winning = riichienv.RiichiEnv(
+        seed=73, game_mode=riichienv.GameType.YON_TONPUSEN, rule=rule
+    )
+    winning.reset(wall=wall, scores=[1000, 33000, 33000, 33000])
+    drawing = winning.clone()
+    before = winning.scores()
+    winning.step(
+        {
+            0: next(
+                action
+                for action in winning.get_observations()[0].legal_actions()
+                if action.action_type == riichienv.ActionType.TSUMO
+            )
+        }
+    )
+    hora = next(event for event in winning.mjai_log if event["type"] == "hora")
+    assert winning.scores() == [
+        score + delta + (1200 if seat == 0 else -400)
+        for seat, (score, delta) in enumerate(zip(before, hora["deltas"]))
+    ]
+    assert winning.honba == 1
+    finish_hand(drawing)
+    assert winning.oya == drawing.oya == 1
+    assert winning.hands == drawing.hands
+    assert winning.wall == drawing.wall
+    assert winning.dora_indicators == drawing.dora_indicators
+    assert winning.scores() != drawing.scores()
+
+    # Even bankruptcy cannot truncate the remaining scheduled boards.
+    winning.set_scores([-1000, 33000, 33000, 35000])
+    for expected_dealer in (1, 2, 3):
+        assert winning.oya == expected_dealer
+        finish_hand(winning)
+    assert winning.done()
+    starts = [
+        event for event in winning.mjai_log if event["type"] == "start_kyoku"
+    ]
+    assert [event["oya"] for event in starts] == [0, 1, 2, 3]
+    assert all(event["bakaze"] == "E" for event in starts)
+
+
+def test_duplicate_rejects_three_player_games():
+    rule = riichienv.GameRule.default_tenhou()
+    rule.duplicate = True
+    with pytest.raises(ValueError, match="[Dd]uplicate|four|4.player"):
+        riichienv.RiichiEnv(game_mode=riichienv.GameType.SAN_IKKYOKU, rule=rule)
+
+
+def test_added_kan_uses_the_next_personal_draw_after_a_real_pon():
+    rule = riichienv.GameRule.default_tenhou()
+    rule.duplicate = True
+    wall = make_wall([[0], [], [1, 2, 3], []])
+    env = riichienv.RiichiEnv(seed=7, game_mode=0, rule=rule)
+    env.reset(wall=wall)
+    env.step({0: riichienv.Action(riichienv.ActionType.DISCARD, tile=0)})
+    env.step(
+        {
+            seat: next(
+                action
+                for action in obs.legal_actions()
+                if action.action_type
+                == (
+                    riichienv.ActionType.PON
+                    if seat == 2
+                    else riichienv.ActionType.PASS
+                )
+            )
+            for seat, obs in env.get_observations(env.active_players).items()
+        }
+    )
+    discard_or_pass(env)
+    for _ in range(20):
+        if env.current_player == 2 and env.phase == riichienv.Phase.WaitAct:
+            break
+        discard_or_pass(env)
+    assert env.current_player == 2
+    assert env.drawn_tile == wall[54]
+    env.step(
+        {
+            2: next(
+                action
+                for action in env.get_observations([2])[2].legal_actions()
+                if action.action_type == riichienv.ActionType.KAKAN
+            )
+        }
+    )
+    assert env.is_rinshan_flag
+    assert env.drawn_tile == wall[58]
+    finish_hand(env)
+    for seat in range(4):
+        draws = [
+            event["pai"]
+            for event in env.mjai_log
+            if event["type"] == "tsumo" and event["actor"] == seat
+        ]
+        assert (
+            draws
+            == [
+                riichienv.convert.tid_to_mjai(tile)
+                for tile in wall[52 + seat : 122 : 4]
+            ][: len(draws)]
+        )
+    assert env.dora_indicators == [wall[131], wall[129]]
+    events = [event["type"] for event in env.mjai_log]
+    kan = events.index("kakan")
+    draw = events.index("tsumo", kan)
+    assert draw < events.index("dora", kan) < events.index("dahai", draw)
+
+
+@pytest.mark.parametrize(
+    "win_type,winner",
+    [(riichienv.ActionType.TSUMO, 2), (riichienv.ActionType.RON, 3)],
+)
+def test_last_personal_draw_allows_scored_wins_but_no_calls(win_type, winner):
+    rule = riichienv.GameRule.default_tenhou()
+    rule.duplicate = True
+    # Seat 0 could pon the final East in a non-exhausted wall. Keeping
+    # these copies concealed also avoids an earlier East causing furiten.
+    hands = [[110, 111], [], [], []]
+    hands[winner] = [0, 1, 8, 9, 16, 17, 36, 37, 44, 45, 72, 73, 108]
+    wall = make_wall(hands, last_draw=109)
+    env = riichienv.RiichiEnv(seed=7, game_mode=0, rule=rule)
+    env.reset(wall=wall)
+    for _ in range(300):
+        if env.drawn_tile == 109:
+            break
+        discard_or_pass(env)
+    assert env.current_player == 2
+    assert env.drawn_tile == 109
+    assert not env.done()
+    obs = env.get_observations([2])[2]
+    assert obs.tiles_left == 0
+    assert env.mjai_log[-1]["type"] == "tsumo"
+    assert env.mjai_log[-1]["tiles_left"] == 0
+    restored = riichienv.Observation.deserialize_from_base64(
+        obs.serialize_to_base64()
+    )
+    assert restored.tiles_left == 0
+    for observation in (obs, restored):
+        assert all(
+            value == 0
+            for value in memoryview(observation.encode()).cast("f")[
+                30 * 34 : 31 * 34
+            ]
+        )
+        assert all(
