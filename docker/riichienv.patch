+"""Incremental replay retains the complete match's full-information events."""
+
+import pytest
+
+import riichienv
+
+
+@pytest.mark.parametrize("duplicate", [False, True])
+def test_incremental_log_matches_full_log_across_hands(duplicate):
+    rule = riichienv.GameRule.default_tenhou()
+    rule.duplicate = duplicate
+    env = riichienv.RiichiEnv(
+        seed=41, game_mode=riichienv.GameType.YON_TONPUSEN, rule=rule
+    )
+    events = env.mjai_log_since(0)
+    assert events == env.mjai_log
+    while not env.done():
+        actions = {}
+        for seat, obs in env.get_observations(env.active_players).items():
+            actions[seat] = next(
+                action
+                for action in obs.legal_actions()
+                if action.action_type
+                == (
+                    riichienv.ActionType.PASS
+                    if env.phase == riichienv.Phase.WaitResponse
+                    else riichienv.ActionType.DISCARD
+                )
+            )
+        env.step(actions)
+        events.extend(env.mjai_log_since(len(events)))
+        assert events == env.mjai_log
+        assert env.mjai_log_since(len(events)) == []
+    starts = [event for event in events if event["type"] == "start_kyoku"]
+    assert len(starts) >= 4
+    assert all("?" not in hand for event in starts for hand in event["tehais"])
+    assert all(
+        event["pai"] != "?" for event in events if event["type"] == "tsumo"
+    )
+    with pytest.raises(IndexError, match="offset exceeds"):
+        env.mjai_log_since(len(events) + 1)
+    with pytest.raises(OverflowError):
+        env.mjai_log_since(-1)
