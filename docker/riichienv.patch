+                    if action.action_type == riichienv.ActionType.ANKAN
+                )
+            }
+        )
+        assert env.drawn_tile == replacement
+        assert env.is_rinshan_flag
+    assert env.rinshan_draw_count == 4
+    assert len(env.melds[0]) == 4
+    assert env.dora_indicators == [
+        wall[position] for position in (131, 129, 127, 125, 123)
+    ]
+    assert env._get_ura_markers() == [
