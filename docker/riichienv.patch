+def test_seed_groups_are_disjoint_and_each_scheduled_board_is_reproducible():
+    rule = riichienv.GameRule.default_tenhou()
+    ordinary = riichienv.RiichiEnv(seed=73, rule=rule)
+    assert ordinary.get_observations([0])[0].tiles_left is None
+    rule.duplicate = True
+    board_groups = []
+    for seed in (73, 74):
+        env = riichienv.RiichiEnv(
+            seed=seed, game_mode=riichienv.GameType.YON_HANCHAN, rule=rule
+        )
+        boards = set()
+        for hand in range(8):
+            env.reset(oya=hand % 4, round_wind=hand // 4)
+            boards.add(tuple(env.wall))
+            snapshot = (env.hands, env.wall, env.dora_indicators)
+            obs = env.get_observations([env.oya])[env.oya]
+            assert obs.tiles_left == 69
+            assert env.mjai_log[-1]["tiles_left"] == 69
+            discard_or_pass(env)
+            env.reset(oya=hand % 4, round_wind=hand // 4)
+            assert (env.hands, env.wall, env.dora_indicators) == snapshot
+            assert tuple(env.wall) in boards
+        assert len(boards) == 8
+        board_groups.append(boards)
+    assert board_groups[0].isdisjoint(board_groups[1])
