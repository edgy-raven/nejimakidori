+            discard_or_pass(env)
+            env.reset(oya=hand % 4, round_wind=hand // 4)
+            assert (env.hands, env.wall, env.dora_indicators) == snapshot
+            assert tuple(env.wall) in boards
+        assert len(boards) == 8
