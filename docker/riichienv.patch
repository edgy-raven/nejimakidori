+    /// Consume a physical tile once, preserving the dead wall in duplicate mode.
+    pub fn draw(&mut self, player: u8, rinshan: bool) -> Option<u8> {
+        if let Some(queues) = &mut self.duplicate_draws {
+            let tile = queues[player as usize].pop()?;
+            let position = self.tiles.iter().position(|&t| t == tile).unwrap();
+            self.tiles.remove(position);
+            self.drawable_count = if queues[player as usize].is_empty() {
+                // This is the last draw: allow tsumo/ron, then settle normally.
+                0
+            } else {
+                self.drawable_count - 1
+            };
+            Some(tile)
+        } else {
+            let tile = if rinshan {
+                Some(self.tiles.remove(0))
+            } else {
+                self.tiles.pop()
+            };
+            if tile.is_some() {
+                self.drawable_count -= 1;
+            }
+            tile
+        }
+    }
+
