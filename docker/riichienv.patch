+    assert not any(
+        action.action_type == riichienv.ActionType.ANKAN
+        for action in env.get_observations([0])[0].legal_actions()
+    )
+    env.step(
+        {
+            0: next(
+                action
+                for action in env.get_observations([0])[0].legal_actions()
+                if action.action_type == riichienv.ActionType.TSUMO
