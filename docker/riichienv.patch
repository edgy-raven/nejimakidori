index 0000000..24b7cb5
--- /dev/null
+++ b/riichienv-core/tests/native_collection.rs
@@ -0,0 +1,83 @@
+use std::collections::HashMap;
+
+use riichienv_core::action::ActionType;
+use riichienv_core::rule::GameRule;
+use riichienv_core::state::GameState;
+use riichienv_core::state::legal_actions::GameStateLegalActions;
+use serde_json::Value;
+
+#[test]
+fn captured_events_match_logged_games_without_string_logging() {
+    for duplicate in [false, true] {
+        let mut rule = GameRule::default_tenhou();
+        rule.duplicate = duplicate;
+        let mut logged = GameState::new(2, false, Some(1944), 0, rule);
+        let mut captured = logged.clone();
+        captured.skip_mjai_logging = true;
+        captured.event_buffer = Some(Vec::new());
+        for state in [&mut logged, &mut captured] {
+            state.reset();
+            state._initialize_round(0, 0, 0, 0, None, None);
+        }
+        let mut cursor = 0;
+        let mut steps = 0;
+        loop {
+            let expected: Vec<Value> = logged.mjai_log[cursor..]
+                .iter()
+                .map(|event| serde_json::from_str(event).unwrap())
+                .collect();
+            assert_eq!(captured.drain_events(), expected);
+            assert!(captured.drain_events().is_empty());
+            assert!(captured.mjai_log.is_empty());
+            assert!(captured.mjai_log_per_player.iter().all(Vec::is_empty));
+            cursor = logged.mjai_log.len();
+            assert_eq!(captured.is_done, logged.is_done);
+            assert_eq!(
+                captured.players.each_ref().map(|player| player.score),
+                logged.players.each_ref().map(|player| player.score)
+            );
+            if logged.is_done {
+                break;
+            }
+            let mut actions = HashMap::new();
+            for player in logged.active_players.clone() {
+                let legal = logged._get_legal_actions_internal(player);
+                assert_eq!(legal, captured._get_legal_actions_internal(player));
+                let action = legal
+                    .iter()
+                    .min_by_key(|action| match action.action_type {
+                        ActionType::Ron | ActionType::Tsumo => 0,
+                        ActionType::Discard => 1,
+                        ActionType::Pass => 2,
+                        _ => 3,
+                    })
+                    .unwrap()
+                    .clone();
+                actions.insert(player, action);
+            }
+            logged.step(&actions);
+            captured.step(&actions);
+            assert!(logged.last_error.is_none());
+            assert!(captured.last_error.is_none());
+            steps += 1;
+            assert!(steps < 10000);
+        }
+        assert!(steps > 100);
+    }
+}
+
+#[test]
+fn native_yaku_flags_use_visible_tiles_and_replace_legal_actions() {
+    let mut state = GameState::new(2, false, Some(1944), 0, GameRule::default_tenhou());
+    let mut observation = state.get_observation(0);
+    observation.melds.iter_mut().for_each(Vec::clear);
+    observation.discards.iter_mut().for_each(Vec::clear);
+    observation.dora_indicators.clear();
+    assert_eq!(observation.yaku_possibility(), [[[1.0; 2]; 21]; 4]);
+    observation.discards[0] = vec![124, 125, 126, 127];
+    let flags = observation.yaku_possibility();
+    assert_eq!(flags[0][1], [0.0; 2]);
+    assert_eq!(flags[1][1], [1.0; 2]);
+    observation.replace_legal_actions(Vec::new());
+    assert!(observation.legal_actions_method().is_empty());
+}
