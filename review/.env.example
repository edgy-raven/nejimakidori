# Keep real session values in .env.local, which is ignored by git.
MAJSOUL_EN_YOSTAR_UID=
MAJSOUL_EN_YOSTAR_TOKEN=
MAJSOUL_EN_YOSTAR_DEVICE_ID=
# A direct Mahjong Soul access token is an optional alternative.
MAJSOUL_EN_ACCESS_TOKEN=
MAJSOUL_EN_OAUTH2_TYPE=22
MAJSOUL_EN_CLIENT_VERSION=WebGL_2022-0.16.236

# Optional private reviewer pool JSON: [{name, region, accountId, envFile}].
MAHJONG_SOUL_REVIEW_ACCOUNTS=
MAHJONG_SOUL_REVIEW_CACHE=
MAHJONG_SOUL_REVIEW_MODEL_REVISION=
